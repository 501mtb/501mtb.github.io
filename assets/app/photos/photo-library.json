    "pdc": {
      "label": "501MTB Cover",
      "requiredRatio": "16:9"
    },
    "rides": {
      "label": "Rides",
      "requiredRatio": "16:9"
    },
    "events": {
      "label": "Events",
      "requiredRatio": "16:9"
    },
    "riders": {
      "label": "Riders",
      "requiredRatio": "3:4"
    },
    "leaders": {
      "label": "Leaders",
      "requiredRatio": "3:4"
    },
    "gallery": {
      "label": "Gallery",
      "requiredRatio": "16:9"
    }
  },
  "slots": {
    "501mtb.pdp": {
      "category": "pdp",
      "requiredRatio": "1:1",
      "selectionMode": "single"
    },
    "501mtb.pdc": {
      "category": "pdc",
      "requiredRatio": "16:9",
      "selectionMode": "slideshow"
