{
  "schemaVersion": 1,
  "library": "501MTB Photo Library",
  "baseUrl": "https://501mtb.github.io/assets/app/photos/",
  "imageFormat": "jpg",
  "supportedRatios": [
    "1:1",
    "16:9",
    "3:4"
